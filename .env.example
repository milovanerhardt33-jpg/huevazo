# Conexión de la API: usuario de base con privilegios mínimos (lo crea db:migrar)
DATABASE_URL=postgres://huevazo_app:CAMBIAR-clave-app@localhost:5432/huevazo

# Conexión administrativa: solo para migraciones y para crear al dueño. No la uses en la API.
DATABASE_ADMIN_URL=postgres://huevazo_admin:CAMBIAR-clave-admin@localhost:5432/huevazo

# Clave que db:migrar le asigna al usuario huevazo_app (debe coincidir con DATABASE_URL)
APP_DB_PASSWORD=CAMBIAR-clave-app

PORT=3000
# true en producción (requiere HTTPS)
COOKIE_SECURE=true
SESSION_HOURS=12
# Número de proxies delante de la app (1 si usás Nginx/Caddy/Render), 0 si no hay
TRUST_PROXY=1
